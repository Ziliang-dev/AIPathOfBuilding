{
  "name": "@aipob/sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Local graph/loop optimization sidecar for AIPathOfBuilding",
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "aipob-sidecar": "./dist/server.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server.cjs --external:better-sqlite3 --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "better-sqlite3": "^13.0.3",
    "openai": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.13",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
